#: INSTRUCTIONS.md:1
msgid ""
"PLUMED Masterclass 22.8: Modelling Concentration-driven processes with "
"PLUMED"
msgstr ""

#: INSTRUCTIONS.md:5
msgid "Origin"
msgstr "作成について"

#: INSTRUCTIONS.md:9
msgid "This masterclass was authored by Matteo Salvalaglio on May 20, 2022"
