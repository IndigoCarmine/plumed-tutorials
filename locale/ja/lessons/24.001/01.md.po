msgstr "**既定値**"

#: 01.md:194
msgid "**Description**"
msgstr "**説明**"

# Literal notation or identifier intentionally preserved.
#: 01.md:196
msgid "NOPBC"
msgstr "NOPBC"

#: 01.md:196 01.md:197 01.md:199 01.md:200 01.md:201 01.md:202 01.md:203
msgid "false"
msgstr "false"

#: 01.md:196
msgid "Ignore the periodic boundary conditions when calculating distances"
msgstr "距離計算で Periodic Boundary Conditions を無視する。"

# Literal notation or identifier intentionally preserved.
#: 01.md:197
msgid "SERIAL"
msgstr "SERIAL"

#: 01.md:197
