msgstr ""
"<b><a "
"href=\"mailto:plumed.tutorials@gmail.com\">plumed.tutorials@gmail.com</a></b>"

#: contribute.md:45
msgid "Fields marked with \"<sup>*</sup>\" are optional"
msgstr "\"<sup>*</sup>\" の付いた項目は任意です"
